# Optional overrides for the contact form. The defaults in
# src/data/contactEndpoint.js already point at the live Supabase project and
# its publishable key, so a local checkout works without this file.
#
# Copy to .env.local (gitignored by Vite) and change only if you are pointing
# the form at a different project or table.
VITE_CONTACT_ENDPOINT=https://YOUR_PROJECT.supabase.co/rest/v1/portfolio_messages
VITE_CONTACT_KEY=YOUR_PUBLISHABLE_KEY
